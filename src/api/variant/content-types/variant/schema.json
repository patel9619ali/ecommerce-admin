{
  "kind": "collectionType",
  "collectionName": "variants",
  "info": {
    "singularName": "variant",
    "pluralName": "variants",
    "displayName": "Variant"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product.product"
    },
    "sku": {
      "type": "string"
    },
    "colorName": {
      "type": "string"
    },
    "colorHex": {
      "type": "string"
    },
    "mrp": {
      "type": "biginteger"
    },
    "sellingPrice": {
      "type": "biginteger"
    },
    "discountPercent": {
      "type": "decimal"
    },
    "stock": {
      "type": "integer"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "isDefault": {
      "type": "boolean"
    },
    "ReturnsAndWarranty": {
      "type": "component",
      "component": "shared.benefit",
      "repeatable": true
    }
  }
}
